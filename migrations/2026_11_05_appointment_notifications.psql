-- Create persistent appointment email notification queue.
-- Safe to run more than once.

CREATE TABLE IF NOT EXISTS appointment_notifications (
    id SERIAL PRIMARY KEY,

    appointment_id INTEGER NOT NULL
        REFERENCES appointments(id) ON DELETE CASCADE,

    notification_type VARCHAR(30) NOT NULL,

    status VARCHAR(20) NOT NULL DEFAULT 'pending',

    scheduled_at TIMESTAMPTZ NOT NULL,

    sent_at TIMESTAMPTZ,

    attempts INTEGER NOT NULL DEFAULT 0,

    last_error TEXT,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT uq_appointment_notification_type
        UNIQUE (appointment_id, notification_type),

    CONSTRAINT ck_appointment_notification_type
        CHECK (notification_type IN ('confirmation', 'reminder_24h')),

    CONSTRAINT ck_appointment_notification_status
        CHECK (status IN ('pending', 'sending', 'sent', 'failed', 'cancelled'))
);

CREATE INDEX IF NOT EXISTS ix_appointment_notifications_status_scheduled
    ON appointment_notifications (status, scheduled_at);

CREATE INDEX IF NOT EXISTS ix_appointment_notifications_appointment_id
    ON appointment_notifications (appointment_id);