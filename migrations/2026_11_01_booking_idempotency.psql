-- Phase 4: persisted idempotency and recoverable Calendar booking state.
-- Safe for existing rows: new request fields are nullable and all prior
-- appointments are marked confirmed. Apply once before deploying Phase 4 code.

ALTER TABLE appointments
    ADD COLUMN IF NOT EXISTS idempotency_key VARCHAR(128),
    ADD COLUMN IF NOT EXISTS request_hash VARCHAR(64),
    ADD COLUMN IF NOT EXISTS booking_state VARCHAR(32) NOT NULL DEFAULT 'confirmed',
    ADD COLUMN IF NOT EXISTS calendar_event_id VARCHAR(255),
    ADD COLUMN IF NOT EXISTS calendar_event_link TEXT;

CREATE UNIQUE INDEX IF NOT EXISTS uq_appointments_business_idempotency_key
    ON appointments (business_id, idempotency_key);
