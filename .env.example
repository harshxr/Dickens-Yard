# PostgreSQL connection components. Set real values as Render secrets.
DB_HOST=<render-internal-postgres-host>
DB_PORT=<postgres-port>
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<set-as-secret>
DB_SSLMODE=<require-for-external-postgres; optional-for-internal>
DB_CONNECT_TIMEOUT=10
DB_POOL_TIMEOUT=10

# Required for appointment Calendar access with an existing stored connection.
CALENDAR_DEMO_BUSINESS_ID=<practice-business-id>
CALENDAR_ENCRYPTION_KEY=<fernet-key-secret>

# OAuth management is local-only in the current backend. Do not enable it on Render.
GOOGLE_CLIENT_ID=<oauth-client-id>
GOOGLE_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_REDIRECT_URI=<approved-oauth-redirect-uri>
OAUTH_STATE_SECRET=<random-state-signing-secret>
CALENDAR_LOCAL_DEV_ONLY=<false-on-render>

# Required only for LiveKit webhook verification and outbound-call features.
LIVEKIT_URL=<livekit-server-url>
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
LIVEKIT_AGENT_NAME=<agent-name>
LIVEKIT_OUTBOUND_TRUNK_ID=<outbound-trunk-id>
OUTBOUND_CALLS_ENABLED=<false-until-approved>
OUTBOUND_CALL_API_TOKEN=<random-32-character-or-longer-server-to-server-secret>
OUTBOUND_CALL_API_CLIENT=<trusted-calling-service-name>
OUTBOUND_CALL_BUSINESS_ID=<authorized-practice-business-id>
OUTBOUND_ALLOWED_CALLER_IDS=<comma-separated-authorized-e164-caller-ids>
OUTBOUND_MAX_CALLS_PER_BUSINESS_PER_HOUR=5
OUTBOUND_MAX_CONCURRENT_CALLS_PER_BUSINESS=1
# Validation only: calls remain disabled; requests create no rows or SIP traffic.
OUTBOUND_CALL_TEST_MODE=<false-unless-using-an-isolated-test-environment>
OUTBOUND_TEST_ALLOWED_NUMBERS=<comma-separated-controlled-e164-test-numbers>

# Leave false on Render. True is only for an explicitly disposable local database.
AUTO_CREATE_TABLES=<false>

# Appointment confirmation and reminder emails (Resend).
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=<verified-sender-address>
EMAIL_REPLY_TO=<optional-reply-to-address>
EMAIL_WORKER_ENABLED=<false-until-email-testing-is-complete>
